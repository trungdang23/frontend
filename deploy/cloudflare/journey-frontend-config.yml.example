tunnel: journey-backend
credentials-file: C:\Users\dangv\.cloudflared\<tunnel-id>.json

ingress:
  # Optional manual/admin SSH route. GitHub Actions deploy no longer depends on this.
  - hostname: ssh.buicojourney.com
    service: ssh://localhost:22
  - hostname: api.buicojourney.com
    service: http://localhost:3001
  - hostname: buicojourney.com
    service: http://localhost:3000
  - hostname: www.buicojourney.com
    service: http://localhost:3000
  - service: http_status:404
